<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/mapsFragment">

    <fragment
        android:id="@+id/mapsFragment"
        android:name="ru.netology.myappwithmaps.fragment.MapsFragment"
        android:label="fragment_maps"
        tools:layout="@layout/fragment_maps" >
        <action
            android:id="@+id/action_mapsFragment_to_targetListFragment"
            app:destination="@id/targetListFragment" />
    </fragment>
    <fragment
        android:id="@+id/targetListFragment"
        android:name="ru.netology.myappwithmaps.fragment.TargetListFragment"
        android:label="fragment_target_list"
        tools:layout="@layout/fragment_target_list" />
</navigation>